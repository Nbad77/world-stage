# Copy this to .env.local for local development
# In production, set VITE_API_URL on Vercel dashboard

# When running the FastAPI backend locally on port 8000, leave this blank
# (Vite proxy handles /game/* requests automatically)
VITE_API_URL=

# For production, set this to your Railway backend URL:
# VITE_API_URL=https://your-app.up.railway.app
